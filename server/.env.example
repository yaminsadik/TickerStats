# TickerStats API runtime configuration

# CORS origins allowed to call the API from browsers.
# Production example: https://your-app.vercel.app,https://www.tickerstats.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database connection strings.
# Docker Compose local DB example:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/ticketstats
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ticketstats
DATABASE_URL=postgresql://tickerstats:tickerstats@localhost:5432/ticketstats
ASYNC_DATABASE_URL=postgresql+asyncpg://tickerstats:tickerstats@localhost:5432/ticketstats

# Auth0 API settings.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_API_AUDIENCE=https://api.tickerstats.com
AUTH0_ALGORITHMS=["RS256"]

# Application runtime.
# Production should use DEBUG=false.
DEBUG=false
ENVIRONMENT=production

# Deck generation through Gemini on Vertex AI.
# This bills usage to the Google Cloud project below. Authenticate with ADC
# locally or a service account in deployment; do not put credentials in the client.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_GEMINI_DEFAULT_MODEL=gemini-3.1-pro-preview

# Production env-var service-account option for hosts that cannot mount files.
# Set this as a secret value, not in a committed file.
# GOOGLE_APPLICATION_CREDENTIALS_JSON_BASE64=base64-encoded-service-account-json

# Local/container service-account file option only.
# Do not set this in production unless the file is actually mounted there.
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/tickerstats-vertex-sa.json

# Legacy Gemini Developer API / AI Studio key.
# Only needed when GOOGLE_GENAI_USE_VERTEXAI=false.
# GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=your-google-api-key

# Gemini-assisted PPTX export.
GEMINI_EXPORT_MODEL=gemini-3.1-pro-preview
# GEMINI_EXPORT_CACHE_DIR=/tmp/tickerstats_gemini_exports
# GEMINI_EXPORT_MAX_TOKENS=8192
# GEMINI_EXPORT_TIMEOUT_SECONDS=120

# Stripe billing.
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_DECK_EXPORT=price_...
STRIPE_PRICE_ID_USAGE_PACK=price_...
# STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_ENTERPRISE=price_...

# Frontend app URL used for Stripe redirects.
FRONTEND_URL=http://localhost:5173

# Optional runtime tuning.
# PORT=5000
# HOST=0.0.0.0
# YFINANCE_MAX_CONCURRENCY=6
# AUTH0_JWKS_CACHE_TTL_SECONDS=3600
# DECK_MAX_RETRIES=2
# DECK_TIMEOUT=60
# DECK_USE_CACHE=true
# DECK_PARALLEL_SECTIONS=false
# DECK_MAX_PARALLEL_WORKERS=5
# DECK_SECTION_DELAY=0.5
