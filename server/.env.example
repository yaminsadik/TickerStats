# TickerStats API runtime configuration

# CORS origins allowed to call the API from browsers
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database connection strings
DATABASE_URL=postgresql://ticketstats:ticketstats@localhost:5432/ticketstats
ASYNC_DATABASE_URL=postgresql+asyncpg://ticketstats:ticketstats@localhost:5432/ticketstats

# Auth0 API settings
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_API_AUDIENCE=https://api.tickerstats.com
AUTH0_ALGORITHMS=["RS256"]

# Application runtime
DEBUG=True
ENVIRONMENT=development

# Deck generation through Gemini on Vertex AI
# This bills usage to the Google Cloud project below. Authenticate with ADC
# locally or a service account in deployment; do not put credentials in the client.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_GEMINI_DEFAULT_MODEL=gemini-3-flash-preview
# Local service-account JSON option only. Prefer ADC/platform identity where possible.
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/tickerstats-vertex-sa.json

# Legacy Gemini Developer API / AI Studio keys. Not needed for Vertex AI billing.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Gemini-assisted PPTX export
# GEMINI_EXPORT_MODEL=gemini-3.1-pro-preview
# GEMINI_EXPORT_CACHE_DIR=/tmp/tickerstats_gemini_exports
# GEMINI_EXPORT_MAX_TOKENS=8192
# GEMINI_EXPORT_TIMEOUT_SECONDS=120

# Stripe subscription billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
# STRIPE_PRICE_ID_ENTERPRISE=price_...
FRONTEND_URL=http://localhost:5173

# Optional runtime tuning
# PORT=5000
# HOST=0.0.0.0
# YFINANCE_MAX_CONCURRENCY=6
# AUTH0_JWKS_CACHE_TTL_SECONDS=3600
# DECK_MAX_RETRIES=2
# DECK_TIMEOUT=60
# DECK_USE_CACHE=true
# DECK_PARALLEL_SECTIONS=false
# DECK_MAX_PARALLEL_WORKERS=5
# DECK_SECTION_DELAY=0.5
