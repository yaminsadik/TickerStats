# Deck Generation Service Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL connection strings
DATABASE_URL=postgresql://ticketstats:ticketstats@localhost:5432/ticketstats
ASYNC_DATABASE_URL=postgresql+asyncpg://ticketstats:ticketstats@localhost:5432/ticketstats

# =============================================================================
# Auth0 Configuration
# =============================================================================

# Auth0 Domain (from Auth0 Dashboard > Applications > Your API)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Auth0 API Audience (Identifier from Auth0 Dashboard > Applications > APIs)

#Auth0 Algorithm
AUTH0_ALGORITHMS=["RS256"]
# =============================================================================
# Application Settings
# =============================================================================

# Enable debug mode (set to false in production)
DEBUG=True
ENVIRONMENT=development

# =============================================================================
# LLM Provider API Keys (at least one required)
# =============================================================================

# OpenAI API Key (required for provider=openai)
OPENAI_API_KEY=

# Google Gemini API Key (required for provider=gemini)
GEMINI_API_KEY=
# Alternative: GOOGLE_API_KEY=your-google-api-key-here

# DeepSeek API Key (required for provider=deepseek)
DEEPSEEK_API_KEY=

# Z.AI API Key (required for provider=zai / GLM models)
ZAI_API_KEY=

# Anthropic API Key (required for provider=anthropic / Claude models)
ANTHROPIC_API_KEY=

# =============================================================================
# Flask Server Configuration
# =============================================================================

# Enable debug mode (set to false in production)
FLASK_DEBUG=false

# Server host and port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Secret key for session management (change in production!)
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# =============================================================================
# Deck Generation Settings
# =============================================================================

# Maximum retry attempts on LLM validation failure
DECK_MAX_RETRIES=2

# LLM request timeout in seconds
DECK_TIMEOUT=60

# Enable caching of generated content
DECK_USE_CACHE=true

# =============================================================================
# Caching Configuration
# =============================================================================

# Cache backend: "memory" (default) or "redis"
CACHE_TYPE=memory

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Redis URL (required if CACHE_TYPE=redis)
# REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Rate Limiting
# =============================================================================

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Default rate limit for all endpoints
RATE_LIMIT_DEFAULT=100 per minute

# Rate limit for /api/v1/deck/generate endpoint
RATE_LIMIT_GENERATE=10 per minute

# =============================================================================
# Logging
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Use JSON format for logs (recommended for production)
LOG_JSON=true

# =============================================================================
# Stripe Configuration
# =============================================================================

# Stripe Secret Key (from Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook Secret (from Stripe Dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from Stripe Dashboard > Products)
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# Frontend URL for redirect after checkout
FRONTEND_URL=http://localhost:3000
