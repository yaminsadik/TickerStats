# Docker ignore file for TickerStats backend
# Prevents unnecessary files from being copied into the Docker image

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment files (secrets should be set at runtime)
.env
.env.*
*.env
secrets/

# Git
.git/
.gitignore
.gitattributes

# Documentation
*.md
!README.md
docs/

# Logs
*.log

# Database
*.db
*.sqlite

# Node (if any JS tooling exists)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Other
.dockerignore
Dockerfile
docker-compose*.yml
*.bak
*.tmp
