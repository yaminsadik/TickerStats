# API base URL for the FastAPI backend
VITE_API_BASE=http://localhost:8000

# Auth0 Configuration
# Get these from your Auth0 dashboard (Applications > Single Page Application)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://api.ticketstats.com

# Stripe Configuration (optional - only needed if using Stripe checkout instead of API)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Checkout link for Pro upgrades (set to your Stripe payment link)
VITE_STRIPE_CHECKOUT_URL=
